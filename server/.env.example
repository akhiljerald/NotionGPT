# Copy to server/.env and fill in your own values. Never commit server/.env.

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Notion public integration (OAuth) ---
# https://www.notion.so/my-integrations -> your integration -> "OAuth Domain & URIs"
# The integration must be a "Public" integration for the OAuth flow to work.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must match a redirect URI registered on the Notion integration exactly.
OAUTH_REDIRECT_URI=http://localhost:3000/home/

# --- Server ---
SERVER_PORT=8081
