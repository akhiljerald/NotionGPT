# Copy to client/.env and fill in. Create React App only exposes vars
# prefixed with REACT_APP_, and they are baked into the JS bundle at build
# time — so put ONLY public values here. Never the OAuth client secret.

# Same value as OAUTH_CLIENT_ID in server/.env (a client id is public).
REACT_APP_NOTION_CLIENT_ID=

# Must match OAUTH_REDIRECT_URI in server/.env and the Notion integration.
REACT_APP_OAUTH_REDIRECT_URI=http://localhost:3000/home/

# Where the Express server is listening.
REACT_APP_API_ENDPOINT=http://localhost:8081/v1
